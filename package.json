{
    "name": "pac-man-charm",
    "private": true,
    "version": "1.0.0",
    "description": "Pac-Man game with React frontend and FastAPI backend",
    "scripts": {
        "dev": "concurrently -n \"backend,frontend\" -c \"yellow,cyan\" \"npm run dev:backend\" \"npm run dev:frontend\"",
        "dev:backend": "cd backend && uv run uvicorn main:app --reload --port 3000",
        "dev:frontend": "cd frontend && npm run dev",
        "install:all": "cd frontend && npm install",
        "test": "concurrently \"npm run test:backend\" \"npm run test:frontend\"",
        "test:backend": "cd backend && uv run pytest -v",
        "test:frontend": "cd frontend && npm run test:run",
        "build": "cd frontend && npm run build"
    },
    "devDependencies": {
        "concurrently": "^8.2.2"
    }
}